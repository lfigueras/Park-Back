<% content_for :title, "ParkBack | Save your parking location" %>

<div data-controller="locator" data-locator-map-permission-url-value="<%= privacy_maps_path %>" data-locator-maps-declined-value="<%= privacy_preferences["maps"] == false %>">
  <%= form_with model: @parking_location, url: parking_locations_path, method: :post, html: { multipart: true, class: "space-y-5", data: { action: "input->locator#refreshSubmit change->locator#refreshSubmit" } } do |f| %>
    <% if @parking_location.errors.any? %>
      <div class="rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700 ring-1 ring-rose-200">
        <ul class="list-disc pl-4">
          <% @parking_location.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="space-y-1 text-center">
      <h1 class="text-2xl font-bold text-ink">Where did you park?</h1>
      <p class="text-sm leading-6 text-slate-500">Save your parking spot and find your way back.</p>
    </section>

    <%# Vehicle type selector %>
    <div>
      <p class="mb-2 text-xs font-medium text-slate-500">What are you parking?</p>
      <div class="grid grid-cols-4 gap-2">
        <% ParkingLocation::VEHICLE_TYPES.each do |type| %>
          <label class="cursor-pointer">
            <%= f.radio_button :vehicle_type, type, checked: @parking_location.vehicle_type == type, class: "peer sr-only" %>
            <div class="flex flex-col items-center gap-1 rounded-xl bg-white px-2 py-3 text-slate-500 shadow-sm ring-1 ring-slate-200/70 transition peer-checked:bg-navy peer-checked:text-white peer-checked:ring-navy">
              <%= vehicle_icon(type, css: "size-6") %>
              <span class="text-[11px] font-medium capitalize"><%= type %></span>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <%# GPS capture status card %>
    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200/70">
      <div class="flex items-center gap-3">
        <div class="grid size-10 place-items-center rounded-full bg-mist text-navy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21Z"/>
            <circle cx="12" cy="10.5" r="2.4"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p data-locator-target="status" data-state="pending" class="text-sm font-medium text-ink">Location not requested</p>
          <p data-locator-target="accuracyText" class="text-xs text-slate-500"></p>
        </div>
        <button type="button" data-action="locator#locate" data-locator-target="retry" aria-describedby="location-privacy-note"
                    class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 ring-1 ring-slate-200 active:scale-95">
                  Use my location
        </button>
      </div>
      <p id="location-privacy-note" class="mt-3 text-xs leading-5 text-slate-600">
        <% if privacy_preferences["maps"] == false %>
          Maps are off by your choice. GPS still works.
          <%= link_to "Change privacy choices", privacy_path, class: "text-navy underline", data: { turbo: false } %>
        <% else %>
          OpenStreetMap receives your IP address and map area. GPS is requested only when you tap Use my location.
          <%= link_to "Turn maps off", privacy_path, class: "text-navy underline", data: { turbo: false } %>
        <% end %>
      </p>
      <div data-locator-target="map" class="mt-3 <%= "hidden" unless maps_allowed? %> h-44 w-full overflow-hidden rounded-xl ring-1 ring-slate-200"></div>
    </div>

    <%= f.hidden_field :latitude, data: { locator_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { locator_target: "longitude" } %>
    <%= f.hidden_field :accuracy, data: { locator_target: "accuracy" } %>

    <%# Optional details %>
    <details class="group rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/70" open>
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-slate-900">
        <span>Add details <span class="text-slate-400">(optional)</span></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 text-slate-400 transition group-open:rotate-180" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
        </svg>
      </summary>
      <div class="space-y-3 px-4 pb-4">
        <div>
          <%= f.label :mall, "Mall / building", class: "mb-1 block text-xs text-slate-500" %>
          <%= f.text_field :mall, placeholder: "e.g. SM Megamall", class: field_classes %>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :floor, "Floor", class: "mb-1 block text-xs text-slate-500" %>
            <%= f.text_field :floor, placeholder: "B2", class: field_classes %>
          </div>
          <div>
            <%= f.label :section, "Section / zone", class: "mb-1 block text-xs text-slate-500" %>
            <%= f.text_field :section, placeholder: "Blue", class: field_classes %>
          </div>
        </div>
        <div>
          <%= f.label :slot, "Slot number", class: "mb-1 block text-xs text-slate-500" %>
          <%= f.text_field :slot, placeholder: "B2-147", class: field_classes %>
        </div>
        <div>
          <%= f.label :landmark, "Landmark", class: "mb-1 block text-xs text-slate-500" %>
          <%= f.text_area :landmark, rows: 2, placeholder: "Near the elevator by the food court", class: field_classes %>
        </div>
        <% if ParkingLocation.photo_uploads_available? %>
        <div data-controller="photo">
          <p class="mb-1 text-xs text-slate-500">Photo of the area</p>

          <%= f.file_field :photo, accept: "image/*",
                data: { photo_target: "input", action: "photo#preview" }, class: "hidden" %>

          <%# Preview (hidden until a photo is chosen) %>
          <div data-photo-target="preview" class="hidden relative mb-2 overflow-hidden rounded-xl ring-1 ring-slate-200">
            <img data-photo-target="image" alt="Parking area preview" class="h-44 w-full object-cover">
            <button type="button" data-action="photo#clear"
                    class="absolute right-2 top-2 grid size-7 place-items-center rounded-full bg-slate-900/70 text-white backdrop-blur">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18"/>
              </svg>
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button type="button" data-action="photo#takePhoto"
                    class="flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-3 py-2.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 active:scale-95">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 7l1-1.5A1.5 1.5 0 0 1 8.8 5h6.4a1.5 1.5 0 0 1 1.3.75L17.5 7H20a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h2.5Z"/>
                <circle cx="12" cy="12.5" r="3.2"/>
              </svg>
              Take Photo
            </button>
            <button type="button" data-action="photo#choose"
                    class="flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-3 py-2.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200 active:scale-95">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0 4 4m-4-4L8 8M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
              </svg>
              Upload
            </button>
          </div>
        </div>
        <% else %>
          <p class="text-xs text-slate-500">Photo uploads are temporarily unavailable.</p>
        <% end %>
      </div>
    </details>

    <p data-locator-target="hint" class="hidden text-center text-xs text-slate-500">
      Add at least one detail above (floor, section, slot, landmark, or a photo) to save your spot.
    </p>

    <p class="text-xs leading-5 text-slate-500">
      Your saved location, details and photo are deleted when you confirm you've found your vehicle.
      Uncleared spots expire after seven days.
      <%= link_to "Privacy notice", privacy_path, class: "text-navy underline", data: { turbo: false } %>
    </p>

    <%= f.submit "Save Parking Location", data: { locator_target: "submit" }, disabled: true,
          class: "w-full rounded-2xl bg-navy px-4 py-4 text-base font-semibold text-white shadow-lg shadow-navy/20 transition hover:bg-navy-dark active:scale-[0.99] disabled:cursor-not-allowed disabled:bg-mist disabled:text-slate-400 disabled:shadow-none" %>
  <% end %>
</div>
