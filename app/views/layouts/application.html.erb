<!DOCTYPE html>
<html>
  <head>
    <% page_title = content_for(:title).presence || "ParkBack" %>
    <% page_description = "ParkBack helps you remember where you parked and find your way back with GPS." %>
    <% share_image_url = "#{request.base_url}/parkback-share.png" %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ParkBack">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= share_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="ParkBack helps you find your way back to your parked vehicle.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= share_image_url %>">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ParkBack">
    <meta name="theme-color" content="#f1efe7">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if flash[:privacy_choices_changed] %>
      <meta name="privacy-choices-updated" content="true">
    <% end %>

    <% ga4_measurement_id = ENV["GA4_MEASUREMENT_ID"].to_s.strip %>
    <% if Rails.env.production? && analytics_allowed? && controller_path == "parking_locations" && ga4_measurement_id.match?(/\AG-[A-Z0-9]+\z/) %>
      <%= tag.meta name: "ga4-measurement-id", content: ga4_measurement_id %>
      <%= javascript_include_tag "https://www.googletagmanager.com/gtag/js?id=#{ga4_measurement_id}", async: true %>
    <% end %>

    <%# Leaflet (OpenStreetMap) %>
    <% if maps_allowed? && controller_path == "parking_locations" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=2">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-cream text-ink antialiased">
    <div class="mx-auto flex min-h-dvh w-full max-w-md flex-col">
      <header class="flex items-center justify-center gap-2 px-5 pt-[max(1.25rem,env(safe-area-inset-top))] pb-3">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="grid size-8 place-items-center rounded-xl bg-navy text-white shadow-sm shadow-navy/30">
            <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
              <path d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21Z" fill="currentColor"/>
              <circle cx="12" cy="10.5" r="2.4" fill="#3a5f97"/>
            </svg>
          </span>
          <span class="text-lg font-bold tracking-tight">Park<span class="text-navy">Back</span></span>
        <% end %>
      </header>

      <% if notice.present? %>
        <div class="mx-5 mb-2 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 ring-1 ring-emerald-200"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mx-5 mb-2 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 ring-1 ring-rose-200"><%= alert %></div>
      <% end %>

      <main class="flex-1 px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
        <%= yield %>
      </main>

      <footer class="border-t border-slate-200 px-5 py-4 text-center text-xs text-slate-500">
        <%= link_to "Privacy & choices", privacy_path, class: "text-navy underline", data: { turbo: false } %>
      </footer>
    </div>
  </body>
</html>
