<% content_for :title, "Saved Photos | ParkBack" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<section class="space-y-5">
  <div class="flex items-baseline justify-between gap-3 border-b border-slate-200 pb-3">
    <h1 class="text-xl font-bold text-ink">Saved photos</h1>
    <span class="text-sm text-slate-500"><%= pluralize(@photo_count, "photo") %></span>
  </div>

  <% if @parking_locations.empty? %>
    <p class="py-8 text-center text-sm text-slate-500">No saved photos on this page.</p>
  <% end %>

  <div class="space-y-6">
    <% @parking_locations.each do |parking_location| %>
      <article class="space-y-2 border-b border-slate-200 pb-5">
        <div class="flex items-center justify-between gap-3 text-sm">
          <h2 class="font-semibold text-ink">Photo #<%= parking_location.id %></h2>
          <span class="capitalize text-slate-500"><%= parking_location.vehicle_type %></span>
        </div>
        <% photo = parking_location.photo %>
        <% if photo.blob.service.exist?(photo.blob.key) %>
          <%= link_to admin_photo_path(parking_location), target: "_blank", rel: "noopener", data: { turbo: false } do %>
            <%= image_tag admin_photo_path(parking_location), alt: "Saved parking photo", loading: "lazy",
                  class: "block aspect-[4/3] w-full rounded-lg bg-slate-100 object-contain" %>
          <% end %>
        <% else %>
          <div class="grid aspect-[4/3] w-full place-items-center rounded-lg bg-slate-100 text-sm text-slate-500">
            File unavailable
          </div>
        <% end %>
        <time datetime="<%= parking_location.saved_at.iso8601 %>" class="block text-xs text-slate-500">
          <%= parking_location.saved_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
        </time>
      </article>
    <% end %>
  </div>

  <nav aria-label="Photo pages" class="flex items-center justify-between gap-3 text-sm text-navy">
    <% if @page > 1 %>
      <%= link_to "Previous", admin_photos_path(page: @page - 1), data: { turbo: false } %>
    <% end %>
    <% if @page * 24 < @photo_count %>
      <%= link_to "Next", admin_photos_path(page: @page + 1), class: "ml-auto", data: { turbo: false } %>
    <% end %>
  </nav>
</section>